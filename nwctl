#!/usr/bin/env bash
# ============================================================
# NWCTL - Nuway Autoware Command Toolkit
#
# Usage:
#   sudo nwctl register <username> --src <src_path>  Register a new target
#   nwctl list                                  List all users
#   nwctl <username> shell                      Enter dev shell
#   nwctl <username> planning-sim               Launch planning simulation
#   nwctl <username> rosbag-replay              Launch rosbag replay
#   nwctl status                                Show running containers
#   nwctl <username> stop                       Stop user's containers
#   nwctl version                               Show version
# ============================================================
NWCTL_VERSION="0.2.2"
set -euo pipefail

# Resolve SCRIPT_DIR: follow symlink if nwctl is installed via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -L "${SOURCE}" ]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"

# Handle commands that don't need env.sh early
case "${1:-}" in
    version|-v|--version) echo "nwctl v${NWCTL_VERSION}"; exit 0 ;;
    help|-h|--help) ;; # fall through to load env.sh and print full help
esac

source "${SCRIPT_DIR}/env.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ---- Init (only create dirs when needed, skip for read-only commands) ----
init_workspace() {
    mkdir -p "${USER_WORKSPACES_ROOT}" "$(dirname "${USER_REGISTRY}")"
    chmod g+rwx "${USER_WORKSPACES_ROOT}" 2>/dev/null || true

    # One-time, non-destructive migration from releases <= 0.1.x.
    if [ ! -e "${USER_REGISTRY}" ] && [ -s "${SCRIPT_DIR}/users.conf" ] &&
       [ "${USER_REGISTRY}" != "${SCRIPT_DIR}/users.conf" ]; then
        cp -p "${SCRIPT_DIR}/users.conf" "${USER_REGISTRY}"
        echo -e "${YELLOW}Migrated legacy registry to ${USER_REGISTRY}${NC}" >&2
    fi
    if [ ! -e "${USER_REGISTRY}" ]; then
        touch "${USER_REGISTRY}"
    fi
}

# Registry mutations under the system state directory are administrator-only.
# A custom state directory remains writable for source-tree development/tests,
# but cannot affect the installed system registry.
require_registry_admin() {
    if [[ "${USER_REGISTRY}" == /var/lib/nwctl/* ]] && [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}Administrator privileges are required to modify the nwctl registry.${NC}" >&2
        echo "Ask an administrator to run this command with sudo." >&2
        return 1
    fi
}

# ---- Registry lock: serialize writes to users.conf ----
# Usage: with_registry_lock <command> [args...]
with_registry_lock() {
    local lock_file="${USER_REGISTRY}.lock"
    (
        flock -x -w 10 200 || { echo -e "${RED}Could not acquire registry lock${NC}"; exit 1; }
        "$@"
    ) 200>"${lock_file}"
}

# ============================================================
# User Management Functions
# ============================================================

# Registry format: username:domain_id:src_path

get_domain_id() {
    local username="$1"
    grep "^${username}:" "${USER_REGISTRY}" | cut -d: -f2
}

get_src_path() {
    local username="$1"
    grep "^${username}:" "${USER_REGISTRY}" | cut -d: -f3-
}

# DOMAIN_ID policy:
#   0-9:   vehicle/production, explicit administrator acknowledgement required
#   10-199: automatically assigned development domains
#   200-232: integration/test domains, administrator assignment only
PRODUCTION_DOMAIN_MIN=0
PRODUCTION_DOMAIN_MAX=9
DOMAIN_ID_START=10
DOMAIN_ID_AUTO_MAX=199

next_domain_id() {
    local candidate
    for ((candidate=DOMAIN_ID_START; candidate<=DOMAIN_ID_AUTO_MAX; candidate++)); do
        cut -d: -f2 "${USER_REGISTRY}" 2>/dev/null | grep -qx "${candidate}" && continue
        echo "${candidate}"
        return 0
    done
    echo -e "${RED}No automatically assignable development DOMAIN_IDs (${DOMAIN_ID_START}-${DOMAIN_ID_AUTO_MAX})${NC}" >&2
    return 1
}

validate_username() {
    local username="$1"
    [[ "${username}" =~ ^[a-zA-Z0-9_-]+$ ]]
}

# Register a new user
# Usage: register_user <username> <src_path>
register_user() {
    local username="$1"
    local src_path="${2:-}"

    # Validate username: only alphanumeric, underscore, hyphen
    if ! validate_username "${username}"; then
        echo -e "${RED}Invalid username '${username}'. Only letters, numbers, underscore, and hyphen are allowed.${NC}"
        return 1
    fi

    # Check if already registered
    if grep -q "^${username}:" "${USER_REGISTRY}" 2>/dev/null; then
        local existing_id existing_src
        existing_id=$(get_domain_id "${username}")
        existing_src=$(get_src_path "${username}")
        echo -e "${YELLOW}User '${username}' is already registered (DOMAIN_ID=${existing_id}, src=${existing_src})${NC}"
        echo ""
        echo "To update source path:"
        echo "  nwctl update ${username} --src <new_path>"
        return 0
    fi

    # Source path is required
    if [ -z "${src_path}" ]; then
        echo -e "${RED}Source path is required${NC}"
        echo ""
        echo "Usage: nwctl register <username> --src <src_path>"
        echo ""
        echo "Example:"
        echo "  # Clone your own code first"
        echo "  cd ~"
        echo "  git clone https://github.com/autowarefoundation/autoware.git myname_autoware"
        echo "  cd myname_autoware && vcs import src < repositories/autoware.repos"
        echo ""
        echo "  # Then register"
        echo "  sudo nwctl register myname --src /home/myname/myname_autoware/src"
        return 1
    fi

    # Validate source path
    src_path=$(realpath "${src_path}" 2>/dev/null || echo "${src_path}")
    if [ ! -d "${src_path}" ]; then
        echo -e "${RED}Source path does not exist: ${src_path}${NC}"
        return 1
    fi
    if [[ "${src_path}" == *$'\n'* ]]; then
        echo -e "${RED}Source path must not contain a newline${NC}"
        return 1
    fi

    # Registration always receives an automatically allocated development ID.
    # Administrators use set-domain for integration or production assignments.
    local domain_id
    domain_id=$(next_domain_id)

    # Create the build workspace for the owner of the registered source tree.
    # Registration runs as root for system installs, while development
    # containers run with the member's host UID/GID.
    local user_ws="${USER_WORKSPACES_ROOT}/${username}" workspace_uid workspace_gid
    workspace_uid=$(stat -c %u "${src_path}")
    workspace_gid=$(stat -c %g "${src_path}")
    mkdir -p "${user_ws}/build" "${user_ws}/install" "${user_ws}/log"
    chown -R "${workspace_uid}:${workspace_gid}" "${user_ws}"
    chmod -R u+rwX,g+rwX "${user_ws}"

    # Write to registry: username:domain_id:src_path
    echo "${username}:${domain_id}:${src_path}" >> "${USER_REGISTRY}"

    echo ""
    echo -e "${GREEN}================================================"
    echo -e " User Registered Successfully"
    echo -e "================================================${NC}"
    echo -e " Username:     ${username}"
    echo -e " DOMAIN_ID:    ${domain_id}"
    echo -e " Source path:  ${src_path}"
    echo ""
    echo -e " Container mapping:"
    echo -e "   /workspace/     <- $(dirname "${src_path}") (your workspace)"
    echo -e "   /opt/autoware/  <- prebuilt packages (shared)"
    echo -e "   /autoware_map/  <- map data (shared, read-only)"
    echo -e "   /rosbag_data/   <- rosbag data (shared, read-only)"
    echo ""
    echo -e " Usage:"
    echo -e "   ${CYAN}nwctl ${username} shell${NC}            Enter dev shell"
    echo -e "   ${CYAN}nwctl ${username} planning-sim${NC}     Planning simulation"
    echo -e "   ${CYAN}nwctl ${username} rosbag-replay${NC}    Rosbag replay"
    echo "================================================"
    echo ""
}

set_user_domain() {
    local username="$1" domain_id="$2" production_ack="${3:-}" tmp old_domain

    if ! validate_username "${username}" ||
       ! grep -q "^${username}:" "${USER_REGISTRY}" 2>/dev/null; then
        echo -e "${RED}User '${username}' is not registered${NC}"
        return 1
    fi
    if ! [[ "${domain_id}" =~ ^[0-9]+$ ]] || [ "${domain_id}" -gt 232 ]; then
        echo -e "${RED}Invalid DOMAIN_ID '${domain_id}' (expected 0-232)${NC}"
        return 1
    fi
    if [ "${domain_id}" -ge "${PRODUCTION_DOMAIN_MIN}" ] &&
       [ "${domain_id}" -le "${PRODUCTION_DOMAIN_MAX}" ] &&
       [ "${production_ack}" != "--production" ]; then
        echo -e "${RED}DOMAIN_ID ${domain_id} is reserved for vehicle/production use.${NC}"
        echo "Repeat with --production after the approved build and exclusive vehicle test window are confirmed."
        return 1
    fi
    if awk -F: -v id="${domain_id}" -v user="${username}" \
       '$2 == id && $1 != user { found=1 } END { exit !found }' "${USER_REGISTRY}"; then
        echo -e "${RED}DOMAIN_ID ${domain_id} is already assigned${NC}"
        return 1
    fi

    old_domain=$(get_domain_id "${username}")
    tmp=$(mktemp "$(dirname "${USER_REGISTRY}")/.users.conf.XXXXXX")
    awk -F: -v user="${username}" -v id="${domain_id}" '
        $1 == user { print $1 ":" id ":" substr($0, index($0, $3)); next }
        { print }
    ' "${USER_REGISTRY}" > "${tmp}"
    chmod --reference="${USER_REGISTRY}" "${tmp}" 2>/dev/null || true
    chown --reference="${USER_REGISTRY}" "${tmp}" 2>/dev/null || true
    mv "${tmp}" "${USER_REGISTRY}"
    echo -e "${GREEN}Updated DOMAIN_ID for '${username}': ${old_domain} -> ${domain_id}${NC}"
}

# List all registered users
list_users() {
    echo ""
    echo -e "${GREEN}Registered Users:${NC}"
    echo "--------------------------------------------------------------------------"
    printf "%-12s %-10s %-8s %s\n" "Username" "DOMAIN_ID" "Status" "Source Path"
    echo "--------------------------------------------------------------------------"
    while IFS=: read -r name did src; do
        local status="stopped"
        if docker ps --filter "label=io.nwctl.user=${name}" --format '{{.Names}}' 2>/dev/null | grep -q .; then
            status="${GREEN}running${NC}"
        fi
        printf "%-12s %-10s " "${name}" "${did}"
        echo -en "${status}"
        printf "\t%s\n" "${src:-N/A}"
    done < "${USER_REGISTRY}"
    echo "--------------------------------------------------------------------------"
    echo ""
}

# Show running containers
show_status() {
    echo ""
    echo -e "${GREEN}Running Autoware Containers:${NC}"
    echo "--------------------------------------------"
    docker ps --filter "label=io.nwctl.managed=true" --format "table {{.Names}}\t{{.Status}}\t{{.Image}}" 2>/dev/null
    echo "--------------------------------------------"
    echo ""
}

# Unregister a user: remove from registry and optionally delete workspace
# Usage: unregister_user <username> [--keep-workspace]
unregister_user() {
    local username="$1"
    local keep_workspace="${2:-}"
    local user_ws="${USER_WORKSPACES_ROOT}/${username}"

    if ! grep -q "^${username}:" "${USER_REGISTRY}" 2>/dev/null; then
        echo -e "${RED}User '${username}' is not registered${NC}"
        return 1
    fi

    # Refuse if user has running containers
    if docker ps --filter "label=io.nwctl.user=${username}" --format '{{.Names}}' 2>/dev/null | grep -q .; then
        echo -e "${RED}User '${username}' has running containers. Stop them first:${NC}"
        echo "  nwctl ${username} stop"
        return 1
    fi

    local did src
    did=$(get_domain_id "${username}")
    src=$(get_src_path "${username}")

    echo "Will unregister '${username}':"
    echo "  DOMAIN_ID:    ${did}"
    echo "  Source path:  ${src} (NOT deleted, you manage it)"
    if [ "${keep_workspace}" = "--keep-workspace" ]; then
        echo "  Workspace:    ${user_ws} (kept)"
    else
        local ws_size="0"
        [ -d "${user_ws}" ] && ws_size=$(du -sh "${user_ws}" 2>/dev/null | cut -f1)
        echo "  Workspace:    ${user_ws} (${ws_size}, WILL BE DELETED)"
    fi
    echo ""
    read -rp "Confirm unregister? [y/N] " confirm
    if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        return 0
    fi

    # Remove from registry
    sed -i "/^${username}:/d" "${USER_REGISTRY}"

    # Delete workspace unless --keep-workspace
    if [ "${keep_workspace}" != "--keep-workspace" ] && [ -d "${user_ws}" ]; then
        rm -rf "${user_ws}"
    fi

    echo -e "${GREEN}Unregistered '${username}'${NC}"
}

# Stop user's containers
stop_user() {
    local username="$1"
    local -a containers=()
    mapfile -t containers < <(docker ps -q --filter "label=io.nwctl.user=${username}" 2>/dev/null)
    if [ "${#containers[@]}" -gt 0 ]; then
        docker stop "${containers[@]}"
        echo -e "${GREEN}Stopped all containers for '${username}'${NC}"
    else
        echo -e "${YELLOW}No running containers for '${username}'${NC}"
    fi
}

# Cleanup orphan resources: exited containers, stale temp files, unused images
cleanup_orphans() {
    local dry_run="${1:-}"

    echo ""
    echo -e "${GREEN}Cleanup Report${NC}"
    echo "--------------------------------------------"

    # 1. Exited nwctl containers
    local exited_containers
    exited_containers=$(docker ps -a --filter "label=io.nwctl.managed=true" --filter "status=exited" --format "{{.Names}}" 2>/dev/null)
    if [ -n "${exited_containers}" ]; then
        echo -e "${YELLOW}Exited containers:${NC}"
        echo "${exited_containers}" | awk '{print "  "$0}'
    else
        echo "Exited containers:  (none)"
    fi

    # 2. Stale entry scripts in /tmp
    local temp_count
    temp_count=$(find /tmp -maxdepth 1 -name 'aw-entry-*.sh' -mtime +0 2>/dev/null | wc -l)
    if [ "${temp_count:-0}" -gt 0 ]; then
        echo -e "${YELLOW}Stale temp files (/tmp/aw-entry-*.sh older than 1 day):${NC}"
        echo "  ${temp_count} file(s)"
    else
        echo "Stale temp files:   (none)"
    fi

    echo "--------------------------------------------"

    if [ -z "${exited_containers}" ] && [ "${temp_count:-0}" -eq 0 ]; then
        echo -e "${GREEN}Nothing to clean up${NC}"
        return 0
    fi

    if [ "${dry_run}" = "--dry-run" ]; then
        echo ""
        echo "Dry run: nothing was removed. Run without --dry-run to clean up."
        return 0
    fi

    echo ""
    read -rp "Proceed with cleanup? [y/N] " confirm
    if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        return 0
    fi

    # Remove exited containers
    if [ -n "${exited_containers}" ]; then
        echo "${exited_containers}" | xargs -r docker rm
    fi

    # Remove stale temp files
    if [ "${temp_count:-0}" -gt 0 ]; then
        find /tmp -maxdepth 1 -name 'aw-entry-*.sh' -mtime +0 -delete 2>/dev/null
    fi

    echo -e "${GREEN}Cleanup complete${NC}"
}

# Clean user build cache
clean_user() {
    local username="$1"
    local user_ws="${USER_WORKSPACES_ROOT}/${username}"

    if [ ! -d "${user_ws}" ]; then
        echo -e "${RED}Workspace not found for '${username}'${NC}"
        return 1
    fi

    local build_size install_size
    build_size=$(du -sh "${user_ws}/build" 2>/dev/null | cut -f1)
    install_size=$(du -sh "${user_ws}/install" 2>/dev/null | cut -f1)

    echo -e "Will clean ${username}'s build cache: build(${build_size}) + install(${install_size})"
    read -rp "Confirm? [y/N] " confirm
    if [[ "${confirm}" =~ ^[Yy]$ ]]; then
        find "${user_ws}/build" "${user_ws}/install" "${user_ws}/log" \
            -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
        echo -e "${GREEN}Cleaned${NC}"
    else
        echo "Cancelled"
    fi
}

# Show disk usage per user
show_disk_usage() {
    echo ""
    echo -e "${GREEN}Disk Usage per User:${NC}"
    echo "--------------------------------------------"
    printf "%-15s %-10s %-10s %-10s\n" "Username" "build" "install" "total"
    echo "--------------------------------------------"
    while IFS=: read -r name did src; do
        local user_ws="${USER_WORKSPACES_ROOT}/${name}"
        if [ -d "${user_ws}" ]; then
            local b_size i_size t_size
            b_size=$(du -sh "${user_ws}/build" 2>/dev/null | cut -f1)
            i_size=$(du -sh "${user_ws}/install" 2>/dev/null | cut -f1)
            t_size=$(du -sh "${user_ws}" 2>/dev/null | cut -f1)
            printf "%-15s %-10s %-10s %-10s\n" "${name}" "${b_size:-0}" "${i_size:-0}" "${t_size:-0}"
        fi
    done < "${USER_REGISTRY}"
    echo "--------------------------------------------"
    local total
    total=$(du -sh "${USER_WORKSPACES_ROOT}" 2>/dev/null | cut -f1)
    echo -e "Total: ${total}"
    echo ""
}

# ============================================================
# Main Logic
# ============================================================

print_help() {
    echo ""
    echo -e "${GREEN}NWCTL${NC} - Nuway Autoware Command Toolkit (v${NWCTL_VERSION})"
    echo ""
    echo "Usage:"
    echo "  sudo nwctl register <username> --src <src_path>  Register with an auto-assigned dev DOMAIN"
    echo "  sudo nwctl update <username> --src <new_path>    Update user source path"
    echo "  sudo nwctl set-domain <username> --domain-id <0-232> [--production]"
    echo "  sudo nwctl unregister <username> [--keep-workspace]  Remove user"
    echo "  nwctl list                                  List all users"
    echo "  nwctl status                                Show running containers"
    echo "  nwctl disk                                  Show disk usage"
    echo "  nwctl cleanup [--dry-run]                   Clean orphan containers & temp files"
    echo "  nwctl pull [--profile <auto|cpu|nvidia>]    Pull the selected image"
    echo "  nwctl completion <bash|zsh>                 Print shell completion setup"
    echo "  nwctl <username> shell                      Enter dev shell"
    echo "  nwctl <username> planning-sim               Planning simulation"
    echo "  nwctl <username> rosbag-replay              Rosbag replay"
    echo "  nwctl <username> stop                       Stop user's containers"
    echo "  nwctl <username> clean                      Clean build cache"
    echo "  nwctl version                               Show version"
    echo "  nwctl check-env                             Run environment check"
    echo ""
    echo "Options (append after mode):"
    echo "  --map-name <name>       Map subdirectory (default: sample-map-rosbag)"
    echo "  --rosbag-path <path>    Override rosbag path"
    echo "  --bag <name>            Specify bag subdirectory"
    echo "  --rate <float>          Playback rate (default: 1.0)"
    echo "  --profile <profile>     Runtime profile: auto, cpu, or nvidia"
    echo ""
    echo "Examples:"
    echo "  sudo nwctl register zhangsan --src /home/zhangsan/zhangsan_autoware/src"
    echo "  nwctl zhangsan planning-sim"
    echo "  nwctl zhangsan rosbag-replay"
    echo "  nwctl zhangsan shell"
    echo "  sudo nwctl update zhangsan --src /home/zhangsan/zhangsan_v2/src"
    echo ""
}

print_completion_setup() {
    local shell_name="${1:-}"
    case "${shell_name}" in
        bash)
            echo "source \"${SCRIPT_DIR}/completions/nwctl.bash\""
            ;;
        zsh)
            echo "fpath=(\"${SCRIPT_DIR}/completions\" \$fpath)"
            echo "autoload -Uz compinit && compinit"
            ;;
        *)
            echo -e "${RED}Usage: nwctl completion <bash|zsh>${NC}" >&2
            return 1
            ;;
    esac
}

complete_users() {
    if [ -r "${USER_REGISTRY}" ]; then
        cut -d: -f1 "${USER_REGISTRY}"
    elif [ -r "${SCRIPT_DIR}/users.conf" ]; then
        cut -d: -f1 "${SCRIPT_DIR}/users.conf"
    fi
}

update_user_source() {
    local username="$1" new_src="$2" tmp
    tmp=$(mktemp "$(dirname "${USER_REGISTRY}")/.users.conf.XXXXXX")
    awk -F: -v user="${username}" -v src="${new_src}" '
        $1 == user { print $1 ":" $2 ":" src; next }
        { print }
    ' "${USER_REGISTRY}" > "${tmp}"
    chmod --reference="${USER_REGISTRY}" "${tmp}" 2>/dev/null || true
    mv "${tmp}" "${USER_REGISTRY}"
}

# Show help if no args
if [ $# -lt 1 ]; then
    print_help
    exit 0
fi

# Handle read-only commands (no workspace init needed)
case "${1:-}" in
    help|-h|--help)
        print_help
        exit 0
        ;;
    version|-v|--version)
        echo "nwctl v${NWCTL_VERSION}"
        exit 0
        ;;
    check-env)
        CHECK_MODE="${2:-all}"
        CHECK_PROFILE="${NWCTL_PROFILE}"
        if [ "${CHECK_MODE}" = "--profile" ]; then
            CHECK_MODE=all
            [ $# -ge 3 ] || { echo -e "${RED}Missing value for --profile${NC}"; exit 1; }
            CHECK_PROFILE="$3"
        elif [ "${3:-}" = "--profile" ]; then
            [ $# -ge 4 ] || { echo -e "${RED}Missing value for --profile${NC}"; exit 1; }
            CHECK_PROFILE="$4"
        elif [ $# -gt 2 ]; then
            echo -e "${RED}Usage: nwctl check-env [mode] [--profile <auto|cpu|nvidia>]${NC}"
            exit 1
        fi
        bash "${SCRIPT_DIR}/check-env.sh" "${CHECK_MODE}" "${CHECK_PROFILE}"
        exit 0
        ;;
    completion)
        print_completion_setup "${2:-}"
        exit $?
        ;;
    _complete)
        [ "${2:-}" = "users" ] && complete_users
        exit 0
        ;;
esac

# All remaining commands need workspace init
init_workspace

# Handle commands
case "$1" in
    register)
        require_registry_admin
        [ $# -lt 2 ] && { echo -e "${RED}Usage: nwctl register <username> --src <src_path>${NC}"; exit 1; }
        REG_USER="$2"; shift 2; REG_SRC=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                --src) [ $# -ge 2 ] || { echo -e "${RED}Missing value for --src${NC}"; exit 1; }; REG_SRC="$2"; shift 2 ;;
                *) echo "Unknown option: $1"; exit 1 ;;
            esac
        done
        with_registry_lock register_user "${REG_USER}" "${REG_SRC}"
        exit 0
        ;;
    update)
        require_registry_admin
        [ $# -lt 2 ] && { echo -e "${RED}Usage: nwctl update <username> --src <new_path>${NC}"; exit 1; }
        UPD_USER="$2"; shift 2; UPD_SRC=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                --src) [ $# -ge 2 ] || { echo -e "${RED}Missing value for --src${NC}"; exit 1; }; UPD_SRC="$2"; shift 2 ;;
                *) echo "Unknown option: $1"; exit 1 ;;
            esac
        done
        if [ -z "${UPD_SRC}" ]; then
            echo -e "${RED}Usage: nwctl update ${UPD_USER} --src <new_path>${NC}"; exit 1
        fi
        if ! validate_username "${UPD_USER}"; then
            echo -e "${RED}Invalid username '${UPD_USER}'${NC}"; exit 1
        fi
        UPD_SRC=$(realpath "${UPD_SRC}" 2>/dev/null || echo "${UPD_SRC}")
        if [ ! -d "${UPD_SRC}" ]; then
            echo -e "${RED}Path does not exist: ${UPD_SRC}${NC}"; exit 1
        fi
        if ! grep -q "^${UPD_USER}:" "${USER_REGISTRY}"; then
            echo -e "${RED}User '${UPD_USER}' is not registered${NC}"; exit 1
        fi
        [[ "${UPD_SRC}" == *$'\n'* ]] && { echo -e "${RED}Source path must not contain a newline${NC}"; exit 1; }
        with_registry_lock update_user_source "${UPD_USER}" "${UPD_SRC}"
        echo -e "${GREEN}Updated source path for '${UPD_USER}': ${UPD_SRC}${NC}"
        exit 0
        ;;
    set-domain)
        require_registry_admin
        [ $# -lt 2 ] && { echo -e "${RED}Usage: nwctl set-domain <username> --domain-id <0-232> [--production]${NC}"; exit 1; }
        DOM_USER="$2"; shift 2; DOM_ID=""; DOM_PRODUCTION=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                --domain-id) [ $# -ge 2 ] || { echo -e "${RED}Missing value for --domain-id${NC}"; exit 1; }; DOM_ID="$2"; shift 2 ;;
                --production) DOM_PRODUCTION="--production"; shift ;;
                *) echo "Unknown option: $1"; exit 1 ;;
            esac
        done
        [ -n "${DOM_ID}" ] || { echo -e "${RED}--domain-id is required${NC}"; exit 1; }
        with_registry_lock set_user_domain "${DOM_USER}" "${DOM_ID}" "${DOM_PRODUCTION}"
        exit 0
        ;;
    unregister)
        require_registry_admin
        [ $# -lt 2 ] && { echo -e "${RED}Usage: nwctl unregister <username> [--keep-workspace]${NC}"; exit 1; }
        UNR_USER="$2"; shift 2
        if ! validate_username "${UNR_USER}"; then
            echo -e "${RED}Invalid username '${UNR_USER}'${NC}"; exit 1
        fi
        UNR_KEEP=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                --keep-workspace) UNR_KEEP="--keep-workspace"; shift ;;
                *) echo "Unknown option: $1"; exit 1 ;;
            esac
        done
        with_registry_lock unregister_user "${UNR_USER}" "${UNR_KEEP}"
        exit 0
        ;;
    list)
        list_users
        exit 0
        ;;
    status)
        show_status
        exit 0
        ;;
    disk)
        show_disk_usage
        exit 0
        ;;
    cleanup)
        cleanup_orphans "${2:-}"
        exit 0
        ;;
    pull)
        PULL_PROFILE="${NWCTL_PROFILE}"
        if [ "${2:-}" = "--profile" ]; then
            [ $# -ge 3 ] || { echo -e "${RED}Missing value for --profile${NC}"; exit 1; }
            PULL_PROFILE="$3"
        elif [ $# -gt 1 ]; then
            echo -e "${RED}Usage: nwctl pull [--profile <auto|cpu|nvidia>]${NC}"
            exit 1
        fi
        nwctl_resolve_profile "${PULL_PROFILE}"
        echo "Profile: ${NWCTL_ACTIVE_PROFILE}"
        echo "Image:   ${AUTOWARE_IMAGE}"
        docker pull "${AUTOWARE_IMAGE}"
        exit 0
        ;;
esac

# ---- User commands ----
USERNAME="$1"
shift

if ! validate_username "${USERNAME}"; then
    echo -e "${RED}Invalid username '${USERNAME}'${NC}"
    exit 1
fi

# Verify user is registered
DOMAIN_ID=$(get_domain_id "${USERNAME}")
if [ -z "${DOMAIN_ID}" ]; then
    echo -e "${RED}User '${USERNAME}' is not registered. Ask an administrator to run: sudo nwctl register ${USERNAME} --src <path>${NC}"
    exit 1
fi

# Default mode
MODE="${1:-shell}"
shift 2>/dev/null || true

# Handle user subcommands
case "${MODE}" in
    stop)
        stop_user "${USERNAME}"
        exit 0
        ;;
    clean)
        clean_user "${USERNAME}"
        exit 0
        ;;
esac

# ---- Parse additional args ----
MAP_NAME="${DEFAULT_MAP_NAME}"
ROSBAG_PATH="${SHARED_ROSBAG_PATH}"
PLAY_RATE="1.0"
ROSBAG_FILE=""
RUNTIME_PROFILE="${NWCTL_PROFILE}"

while [[ $# -gt 0 ]]; do
    case $1 in
        --map-name|--rosbag-path|--bag|--rate|--profile)
            [ $# -ge 2 ] || { echo -e "${RED}Missing value for $1${NC}"; exit 1; }
            case $1 in
                --map-name) MAP_NAME="$2" ;;
                --rosbag-path) ROSBAG_PATH="$2" ;;
                --bag) ROSBAG_FILE="$2" ;;
                --rate) PLAY_RATE="$2" ;;
                --profile) RUNTIME_PROFILE="$2" ;;
            esac
            shift 2
            ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

nwctl_resolve_profile "${RUNTIME_PROFILE}"

if ! [[ "${PLAY_RATE}" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
   ! awk -v rate="${PLAY_RATE}" 'BEGIN { exit !(rate > 0) }'; then
    echo -e "${RED}Invalid --rate '${PLAY_RATE}': expected a number greater than zero${NC}"
    exit 1
fi

if ! [[ "${MAP_NAME}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo -e "${RED}Invalid --map-name '${MAP_NAME}': expected a map directory name${NC}"
    exit 1
fi

for model_name in "${VEHICLE_MODEL}" "${SENSOR_MODEL}"; do
    if ! [[ "${model_name}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        echo -e "${RED}Invalid vehicle/sensor model name '${model_name}'${NC}"
        exit 1
    fi
done

if [ -n "${ROSBAG_FILE}" ]; then
    rosbag_base=$(realpath -e "${ROSBAG_PATH}" 2>/dev/null || true)
    rosbag_selected=$(realpath -e "${ROSBAG_PATH%/}/${ROSBAG_FILE}" 2>/dev/null || true)
    if [ -z "${rosbag_base}" ] || [ -z "${rosbag_selected}" ] ||
       [[ "${rosbag_selected}/" != "${rosbag_base}/"* ]]; then
        echo -e "${RED}Invalid --bag '${ROSBAG_FILE}': expected a subdirectory of ${ROSBAG_PATH}${NC}"
        exit 1
    fi
    ROSBAG_PATH="${rosbag_selected}"
fi

# ---- User workspace ----
USER_WS="${USER_WORKSPACES_ROOT}/${USERNAME}"
CONTAINER_NAME="aw-${USERNAME}-${MODE}"
mkdir -p "${USER_WS}/build" "${USER_WS}/install" "${USER_WS}/log"
chmod -R g+rwX "${USER_WS}" 2>/dev/null || true

# Get user's source path from registry
USER_SRC_PATH=$(get_src_path "${USERNAME}")
if [ -z "${USER_SRC_PATH}" ] || [ ! -d "${USER_SRC_PATH}" ]; then
    echo -e "${RED}Invalid source path: ${USER_SRC_PATH:-not set}${NC}"
    echo "Update with: nwctl update ${USERNAME} --src <correct_path>"
    exit 1
fi

# shell mode: mount user's workspace; other modes: use prebuilt image only
if [ "${MODE}" = "shell" ]; then
    USER_WORKSPACE_ROOT="$(dirname "${USER_SRC_PATH}")"
    SRC_MOUNT=(
        -v "${USER_WORKSPACE_ROOT}:/workspace"
        -v "${USER_WS}/build:/workspace/build"
        -v "${USER_WS}/install:/workspace/install"
        -v "${USER_WS}/log:/workspace/log"
    )
else
    SRC_MOUNT=()
fi

if [ ! -d "${SHARED_MAP_PATH}/${MAP_NAME}" ]; then
    echo -e "${RED}Map directory does not exist: ${SHARED_MAP_PATH}/${MAP_NAME}${NC}"
    exit 1
fi

if [ "${MODE}" = "rosbag-replay" ] && [ ! -d "${ROSBAG_PATH}" ]; then
    echo -e "${RED}Rosbag directory does not exist: ${ROSBAG_PATH}${NC}"
    exit 1
fi
ROSBAG_STORAGE_ID=""
if [ "${MODE}" = "rosbag-replay" ]; then
    ROSBAG_METADATA="${ROSBAG_PATH}/metadata.yaml"
    if [ ! -r "${ROSBAG_METADATA}" ]; then
        echo -e "${RED}Rosbag metadata does not exist or is not readable: ${ROSBAG_METADATA}${NC}"
        echo "Set --rosbag-path to the directory that directly contains metadata.yaml."
        exit 1
    fi
    ROSBAG_STORAGE_ID=$(awk -F: '
        /^[[:space:]]*storage_identifier:/ {
            sub(/^[^:]*:[[:space:]]*/, "")
            gsub(/[[:space:]\"\047]/, "")
            print
            exit
        }
    ' "${ROSBAG_METADATA}")
    if ! [[ "${ROSBAG_STORAGE_ID}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        echo -e "${RED}Invalid or missing storage_identifier in ${ROSBAG_METADATA}${NC}"
        exit 1
    fi
fi

# ---- Detect DISPLAY ----
if [ -z "${DISPLAY:-}" ]; then
    if [ -S "/tmp/.X11-unix/X1" ]; then
        export DISPLAY=:1
    elif [ -S "/tmp/.X11-unix/X0" ]; then
        export DISPLAY=:0
    else
        echo -e "${RED}Error: No display detected. Set DISPLAY env variable.${NC}"
        exit 1
    fi
fi

if [ -z "${XAUTHORITY:-}" ]; then
    if [ -f "/run/user/$(id -u)/gdm/Xauthority" ]; then
        XAUTHORITY="/run/user/$(id -u)/gdm/Xauthority"
        export XAUTHORITY
    fi
fi

# ---- Check if container is already running ----
if docker ps --filter "name=^/${CONTAINER_NAME}$" --format '{{.Names}}' 2>/dev/null | grep -qx "${CONTAINER_NAME}"; then
    echo -e "${YELLOW}Container '${CONTAINER_NAME}' is already running. Attaching...${NC}"
    docker exec -it "${CONTAINER_NAME}" /bin/bash
    exit $?
fi

XHOST_GRANTED=0
DISPLAY_ARGS=(-e "DISPLAY=${DISPLAY}" -v /tmp/.X11-unix:/tmp/.X11-unix)
if [ -n "${XAUTHORITY:-}" ] && [ -r "${XAUTHORITY}" ]; then
    DISPLAY_ARGS+=(
        -e XAUTHORITY=/tmp/.nwctl.Xauthority
        -v "${XAUTHORITY}:/tmp/.nwctl.Xauthority:ro"
    )
else
    echo -e "${YELLOW}No readable Xauthority file; using temporary local Docker X11 access${NC}"
    if xhost +local:docker >/dev/null 2>&1; then
        XHOST_GRANTED=1
    fi
fi

# ---- Generate container entry script ----
ENTRYPOINT_SCRIPT=$(mktemp /tmp/aw-entry-XXXXXX.sh)
CONTAINER_OWNED=0
cleanup_container() {
    if [ "${CONTAINER_OWNED:-0}" -ne 1 ]; then
        return
    fi

    # Only clean up the exact container created by this invocation.
    if [ "$(docker inspect --format '{{index .Config.Labels "io.nwctl.managed"}}' \
            "${CONTAINER_NAME}" 2>/dev/null || true)" = "true" ]; then
        docker stop -t "${NWCTL_STOP_TIMEOUT:-10}" "${CONTAINER_NAME}" >/dev/null 2>&1 || true
        docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
    fi
}
cleanup_runtime() {
    cleanup_container
    rm -f "${ENTRYPOINT_SCRIPT:-}"
    if [ "${XHOST_GRANTED:-0}" -eq 1 ]; then
        xhost -local:docker >/dev/null 2>&1 || true
    fi
}
handle_runtime_signal() {
    local status="$1"
    trap - INT TERM
    cleanup_runtime
    exit "${status}"
}
trap cleanup_runtime EXIT
trap 'handle_runtime_signal 130' INT
trap 'handle_runtime_signal 143' TERM

case "${MODE}" in
    shell)
        cat > "${ENTRYPOINT_SCRIPT}" << ENTRY_EOF
#!/bin/bash
# Fix home directory permissions and write env config
sudo chown -R \$(id -u):\$(id -g) \$HOME 2>/dev/null || true
mkdir -p ~/.ros
grep -q "ROS_DOMAIN_ID" ~/.bashrc 2>/dev/null || {
    echo "export ROS_DOMAIN_ID=${DOMAIN_ID}" >> ~/.bashrc
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> ~/.bashrc
    echo "[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash || source /opt/autoware/setup.bash" >> ~/.bashrc
}
[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash || source /opt/autoware/setup.bash
echo ""
echo "========================================"
echo " Autoware Dev Environment Ready"
echo "========================================"
echo " Prebuilt:    /opt/autoware/ (base layer)"
echo " Your source: /workspace/src/"
echo " Your build:  /workspace/build/ & install/"
echo ""
echo " Development workflow:"
echo "   1. Edit code under /workspace/src/"
echo "   2. colcon build --packages-select <pkg> --symlink-install"
echo "   3. [ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash || source /opt/autoware/setup.bash"
echo "   4. Test your changes"
echo "========================================"
echo ""
exec /bin/bash
ENTRY_EOF
        ;;
    planning-sim)
        cat > "${ENTRYPOINT_SCRIPT}" << ENTRY_EOF
#!/bin/bash
sudo chown -R \$(id -u):\$(id -g) \$HOME 2>/dev/null || true
mkdir -p ~/.ros
grep -q "ROS_DOMAIN_ID" ~/.bashrc 2>/dev/null || {
    echo "export ROS_DOMAIN_ID=${DOMAIN_ID}" >> ~/.bashrc
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> ~/.bashrc
    echo "source /opt/autoware/setup.bash" >> ~/.bashrc
}
source /opt/autoware/setup.bash
ros2 launch autoware_launch planning_simulator.launch.xml \
    map_path:=/autoware_map/${MAP_NAME} \
    vehicle_model:=${VEHICLE_MODEL} \
    sensor_model:=${SENSOR_MODEL}
ENTRY_EOF
        ;;
    rosbag-replay)
        ROSBAG_CPU_LAUNCH_ARGS=""
        ROSBAG_START_DELAY="${NWCTL_ROSBAG_START_DELAY:-30}"
        if [ "${NWCTL_ACTIVE_PROFILE}" = "cpu" ]; then
            # The upstream launch file declares a CUDA parameter path even when
            # CUDA is disabled. Point it at an existing CPU YAML so the no-GPU
            # image does not try to resolve the absent CUDA package.
            ROSBAG_CPU_LAUNCH_ARGS="perception:=false launch_perception:=false use_cuda_ground_segmentation:=false cuda_ground_segmentation_node_param_path:=/opt/autoware/autoware_ground_segmentation/share/autoware_ground_segmentation/config/scan_ground_filter.param.yaml"
            ROSBAG_START_DELAY="${NWCTL_ROSBAG_START_DELAY:-60}"
        fi
        cat > "${ENTRYPOINT_SCRIPT}" << ENTRY_EOF
#!/bin/bash
sudo chown -R \$(id -u):\$(id -g) \$HOME 2>/dev/null || true
mkdir -p ~/.ros
grep -q "ROS_DOMAIN_ID" ~/.bashrc 2>/dev/null || {
    echo "export ROS_DOMAIN_ID=${DOMAIN_ID}" >> ~/.bashrc
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> ~/.bashrc
    echo "source /opt/autoware/setup.bash" >> ~/.bashrc
}
source /opt/autoware/setup.bash
ros2 launch autoware_launch logging_simulator.launch.xml \
    map_path:=/autoware_map/${MAP_NAME} \
    vehicle_model:=${VEHICLE_MODEL} \
    sensor_model:=${SENSOR_MODEL} \
    ${ROSBAG_CPU_LAUNCH_ARGS} &
launch_pid=\$!
trap 'kill "\${launch_pid}" 2>/dev/null || true' EXIT
sleep "${ROSBAG_START_DELAY}"
if ! kill -0 "\${launch_pid}" 2>/dev/null; then
    echo "Autoware logging simulator exited before rosbag playback" >&2
    wait "\${launch_pid}"
    exit \$?
fi
ros2 bag play /rosbag_data -r ${PLAY_RATE} -s ${ROSBAG_STORAGE_ID}
wait "\${launch_pid}"
ENTRY_EOF
        ;;
    *)
        echo -e "${RED}Unknown mode: ${MODE}${NC}"
        print_help
        exit 1
        ;;
esac
chmod +x "${ENTRYPOINT_SCRIPT}"

# ---- Print info ----
echo ""
echo -e "${GREEN}================================================"
echo -e " Autoware - ${MODE}"
echo -e "================================================${NC}"
echo -e " User:       ${CYAN}${USERNAME}${NC} (DOMAIN_ID=${DOMAIN_ID})"
echo -e " Container:  ${CONTAINER_NAME}"
echo -e " Image:      ${AUTOWARE_IMAGE}"
echo -e " Profile:    ${NWCTL_ACTIVE_PROFILE}"
if [ "${MODE}" = "shell" ]; then
    echo -e " Workspace:  $(dirname "${USER_SRC_PATH}") -> /workspace"
fi
echo -e " Map:        ${SHARED_MAP_PATH}/${MAP_NAME}"
echo -e " DISPLAY:    ${DISPLAY}"
echo ""

if [ "${MODE}" = "shell" ]; then
    echo " Dev guide:"
    echo "   cd /workspace"
    echo "   colcon build --packages-select <pkg> --symlink-install"
    echo "   [ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash || source /opt/autoware/setup.bash"
    echo ""
fi

if [ "${MODE}" = "planning-sim" ]; then
    echo " Steps:"
    echo "   1. Wait for rviz2 window to appear"
    echo "   2. Click '2D Pose Estimate' to set initial pose"
    echo "   3. Click '2D Goal Pose' to set destination"
    echo "   4. Click buttons in AutowareStatePanel to start"
    echo ""
fi

if [ "${MODE}" = "rosbag-replay" ]; then
    echo " Rosbag replay:"
    echo "   Storage: ${ROSBAG_STORAGE_ID}"
    echo "   Playback starts automatically after Autoware initialization."
    echo "   In rviz Views, set Target Frame to 'base_link' to follow the vehicle."
    echo ""
fi

echo "================================================"
echo ""

# ---- Auto-pull image if not found locally ----
if ! docker image inspect "${AUTOWARE_IMAGE}" &>/dev/null; then
    echo -e "${YELLOW}Image not found locally. Pulling ${AUTOWARE_IMAGE}...${NC}"
    echo "This may take a while (~15GB)."
    docker pull "${AUTOWARE_IMAGE}" || { echo -e "${RED}Failed to pull image${NC}"; exit 1; }
fi

# ---- Launch container ----
# Use docker run without exec so trap can clean up temp file
RUNTIME_ARGS=()
if [ "${NWCTL_ACTIVE_PROFILE}" = "nvidia" ]; then
    RUNTIME_ARGS+=(
        --runtime="${NWCTL_NVIDIA_RUNTIME}"
        -e NVIDIA_DRIVER_CAPABILITIES=all
    )
else
    RUNTIME_ARGS+=(
        -e LIBGL_ALWAYS_SOFTWARE=1
        -e GALLIUM_DRIVER=llvmpipe
    )
fi

CONTAINER_OWNED=1
docker run -it --rm \
    --name "${CONTAINER_NAME}" \
    --label io.nwctl.managed=true \
    --label "io.nwctl.user=${USERNAME}" \
    --label "io.nwctl.mode=${MODE}" \
    --network="${NWCTL_NETWORK_MODE}" \
    --ipc="${NWCTL_IPC_MODE}" \
    --cap-add=NET_ADMIN \
    "${RUNTIME_ARGS[@]}" \
    "${DISPLAY_ARGS[@]}" \
    -e XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    -e RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    -e CYCLONEDDS_URI="${NWCTL_CYCLONEDDS_URI}" \
    -e ROS_DOMAIN_ID="${DOMAIN_ID}" \
    -e TZ="$(cat /etc/timezone 2>/dev/null || echo UTC)" \
    -e LOCAL_UID="$(id -u)" \
    -e LOCAL_GID="$(id -g)" \
    -e LOCAL_USER="$(id -un)" \
    -e LOCAL_GROUP="$(id -gn)" \
    "${SRC_MOUNT[@]+"${SRC_MOUNT[@]}"}" \
    -v "${SHARED_MAP_PATH}":/autoware_map:ro \
    -v "${SHARED_DATA_PATH}":/autoware_data:ro \
    -v "${ROSBAG_PATH}":/rosbag_data:ro \
    -v "${ENTRYPOINT_SCRIPT}":/entry.sh:ro \
    "${AUTOWARE_IMAGE}" \
    bash /entry.sh
